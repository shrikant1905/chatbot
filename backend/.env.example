# Kiaan AI Backend Environment Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kiaan_ai
DB_CONNECTION_LIMIT=10

# AI Provider Configuration (Future VPS Ollama / Local Ollama / Direct API)
# Options: ollama, openai, gemini, mock_test
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://159.198.65.194:11434
OLLAMA_DEFAULT_MODEL=qwen3:1.7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Universal AI Gateway & Concurrency Queue
AI_MAX_CONCURRENCY=2
AI_CACHE_TTL_MS=600000

# Alternative API Keys (Leave blank if using Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Attachments Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

