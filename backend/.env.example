# Kiaan AI Backend Environment Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kiaan_ai
DB_CONNECTION_LIMIT=10

# AI Provider Configuration (Future VPS Ollama / Local Ollama / Direct API)
# Options: ollama, openai, gemini, mock_test
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3:latest

# Alternative API Keys (Leave blank if using Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Attachments Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

