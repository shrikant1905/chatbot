# Kiaan AI Backend Environment Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kiaan_ai
DB_CONNECTION_LIMIT=10

# AI Provider Configuration (Future VPS Ollama / Local Ollama / Direct API)
# Options: ollama, openai, gemini, mock_test
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://159.198.65.194:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# RAM Optimization for VPS (Prevents OOM Crashes on multi-turn conversations)
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=2048

# Universal AI Gateway & Concurrency Queue
AI_MAX_CONCURRENCY=2
AI_CACHE_TTL_MS=600000

# Alternative API Keys (Leave blank if using Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# xAI Grok API Configuration
GROK_API_KEY=your_xai_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_DEFAULT_MODEL=grok-4.20-0309-non-reasoning

# Attachments Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Tavily Real-Time Web Search Integration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_ENABLED=true

# ComfyUI & Stable Diffusion 1.5 Image Generation
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ENABLED=true
SD_MODEL_NAME=v1-5-pruned-emaonly.safetensors
IMAGE_QUEUE_CONCURRENCY=1
SD_STEPS=20
SD_CFG=7.0
SD_WIDTH=512
SD_HEIGHT=512
