          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search keyword (e.g. Acme Corp, John)" },
            "status": { "type": "string", "enum": ["all", "new", "contacted", "qualified", "lost"], "default": "all" },
            "limit": { "type": "integer", "default": 5, "maximum": 20 }
          },
          "required": ["query"]
        }
      }
    },
    {
