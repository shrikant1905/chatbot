        "parameters": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "description": "Full name of the contact" },
            "company": { "type": "string", "description": "Company name" },
            "email": { "type": "string", "description": "Contact email address" },
            "phone": { "type": "string", "description": "Phone number" },
